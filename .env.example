# ─── FreeMail Environment Configuration ─────────────
# Copy this to .env and fill in your values

# ─── Database ────────────────────────────────────────
POSTGRES_USER=freemail
POSTGRES_PASSWORD=freemail_secret
POSTGRES_DB=freemail
DATABASE_URL=postgresql+asyncpg://freemail:freemail_secret@localhost:5432/freemail
DATABASE_URL_SYNC=postgresql://freemail:freemail_secret@localhost:5432/freemail

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT / Auth ──────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Environment ─────────────────────────────────────
ENVIRONMENT=development

# ─── Email Provider ─────────────────────────────────
# Supported: mock, ses, sendgrid, mailgun, postmark
EMAIL_PROVIDER=mock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# ─── AI Provider ────────────────────────────────────
# Supported: mock, openai, gemini
AI_PROVIDER=mock
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ─── File Storage ───────────────────────────────────
# Supported: local, s3, r2
STORAGE_PROVIDER=local
# AWS_S3_BUCKET=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# CLOUDFLARE_R2_ENDPOINT=

# ─── Frontend ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FreeMail
